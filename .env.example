PORT=4000

# FRONTEND
# Asal yang boleh memanggil backend, dipisah koma: Vercel dan Vite lokal (npm run dev)
CORS_ORIGIN=https://pitchku.vercel.app,http://localhost:5173
# Alamat backend yang sudah di-deploy, muncul sebagai server "Production" di /docs. Kosong = lokal saja.
PUBLIC_URL=

# SUPABASE
# Proyek lama memakai SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY. Dua-duanya diterima.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# PITCHKU-AI (repo Rifka)
# Backend memanggil POST {AI_SERVICE_URL}/api/v1/decks/generate. Tanpa garis miring di akhir.
# Lokal: jalankan pitchku-ai dengan PORT=4001 supaya tidak bentrok dengan backend di 4000.
# Di Railway: http://<nama-service-pitchku-ai>.railway.internal:<PORT>
AI_SERVICE_URL=http://localhost:4001
# Label model di generation_logs, sama dengan model yang dipakai pitchku-ai
LLM_MODEL=gpt-5.6-luna

# OPSIONAL
# AI_TIMEOUT_MS=180000          batas tunggu satu deck, bawaan 3 menit
# INTERNAL_API_KEY=             dikirim sebagai x-internal-key; pitchku-ai belum memeriksanya
# LLM_PRICE_INPUT_PER_1M=       harga per sejuta token untuk estimated_cost_usd
# LLM_PRICE_OUTPUT_PER_1M=
