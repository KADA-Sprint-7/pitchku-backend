PORT=
CORS_ORIGIN=
PUBLIC_URL=

#SUPABASE
# Proyek baru pakai SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY. Dua-duanya diterima.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

#PITCHKU-AI SERVICE (repo Rifka, di-deploy terpisah)
# Backend memanggil POST {AI_SERVICE_URL}/api/v1/decks/generate. Tanpa garis miring di akhir.
# AI_TIMEOUT_MS: satu deck dibuat dalam satu panggilan; kosong = 180000 (3 menit).
# INTERNAL_API_KEY opsional: dikirim sebagai x-internal-key, belum diperiksa pitchku-ai.
AI_SERVICE_URL=
INTERNAL_API_KEY=
AI_TIMEOUT_MS=

#GENERATION LOGS
# Label model di generation_logs, misalnya qwen3:8b. Kosong = "pitchku-ai".
LLM_MODEL=
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

#OPSIONAL
UNSPLASH_ACCESS_KEY=
